    <string name="settings_section_webhook">Notification Webhook Integration</string>
    <string name="settings_webhook_title">Notification Relay Webhook</string>
    <string name="settings_webhook_desc">Forward Android notifications to your server</string>
    <string name="settings_webhook_relay_summary">Personal Records gathers data through an external webhook relay. The companion Notification Relay Webhook app automatically pushes your notifications to your server:</string>
    <string name="settings_target_webhook_url">Target Webhook URL:</string>
    <string name="settings_setup_guide_title">3-Step Easy Setup</string>
    <string name="settings_setup_step_1">1. Install Notification Relay APK and grant Notification Access permission.</string>
    <string name="settings_setup_step_2">2. In Webhooks tab tap \'+\' and paste the target webhook URL above.</string>
    <string name="settings_setup_step_3">3. Tap Test and save. All notifications will be saved to your database automatically.</string>

