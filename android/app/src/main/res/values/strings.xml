    <!-- Plugin Descriptions -->
    <string name="plugin_desc_web_scrobbler">Directly scrobble music played in Chrome, Firefox, or Edge to your server.</string>
    <string name="plugin_long_desc_web_scrobbler">Supports YouTube, Spotify Web, SoundCloud, Bandcamp, and 300+ web music players. Scrobbles directly to your webhook endpoint.</string>
    <string name="plugin_desc_lastfm">Music scrobble history and profile synchronization.</string>
    <string name="plugin_long_desc_lastfm">Fetches scrobble history from Last.fm at regular intervals to keep your music statistics up to date.</string>
    <string name="plugin_desc_goodreads">Book reading log and shelves synchronization.</string>
    <string name="plugin_long_desc_goodreads">Syncs read and want-to-read books using your public Goodreads profile RSS feed.</string>
    <string name="plugin_desc_letterboxd">Film diary and movie ratings synchronization.</string>
    <string name="plugin_long_desc_letterboxd">Reads your Letterboxd RSS feed to import watched films, ratings, and diary entries to your server.</string>
    <string name="plugin_desc_fatsecret">Daily calorie, macronutrient, and meal diary integration.</string>
    <string name="plugin_long_desc_fatsecret">Securely connects using your own FatSecret Platform API keys (BYOK) to sync food and meal intake.</string>
    <string name="plugin_desc_health_connect">Sync steps, sleep, heart rate, and workouts from your device.</string>
    <string name="plugin_long_desc_health_connect">Uses the open-source Health Connect Webhook companion app to relay health and activity metrics to your server.</string>
    <string name="plugin_desc_notification_relay">Capture and categorize Android device notification streams securely.</string>
    <string name="plugin_long_desc_notification_relay">Captures incoming device notifications with Notification Relay and logs them to your personal timeline.</string>
    <string name="plugin_desc_spotify">Direct Spotify Connect and playback tracking integration.</string>
    <string name="plugin_long_desc_spotify">Coming soon: Playlist and currently playing track synchronization via Spotify Developer API.</string>

