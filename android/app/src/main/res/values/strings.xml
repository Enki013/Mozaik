    <string name="settings_section_architecture">Hybrid Architecture &amp; Plugins</string>
    <string name="settings_architecture_title">Extensible Data Hub</string>
    <string name="settings_architecture_subtitle">Central personal data gathered from 3 pipelines</string>
    <string name="settings_architecture_desc">Personal Records pools all records into a central server repository. The Android app acts as a reader and control panel. Future services attach as modular plugins:</string>
    <string name="settings_plugin_webhook_title">1. Webhook Plugins (Push)</string>
    <string name="settings_plugin_webhook_desc">Instant notification and sensor data via Notification Relay APK, Tasker, or Home Assistant.</string>
    <string name="settings_plugin_rss_title">2. RSS Plugins (Pull / Polling)</string>
    <string name="settings_plugin_rss_desc">Periodic background polling of public RSS feeds like Letterboxd and Goodreads.</string>
    <string name="settings_plugin_api_title">3. OTT / OAuth Plugins (API)</string>
    <string name="settings_plugin_api_desc">FatSecret OAuth BYOK. Upcoming: Spotify listening history and Steam library.</string>

