name = "personal-records-api"
main = "src/index.ts"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]

[[d1_databases]]
binding = "DB"
database_name = "personal-records-db"
# Paste the database_id printed by "npx wrangler d1 create personal-records-db":
database_id = "YOUR_D1_DATABASE_ID"

[triggers]
crons = ["0 */6 * * *"]
